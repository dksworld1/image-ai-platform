<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="foundationProbe">
  <insert id="insert">
    INSERT INTO foundation_probe (probe_value) VALUES (#{value})
  </insert>
  <select id="countByValue" resultType="long">
    SELECT COUNT(*) FROM foundation_probe WHERE probe_value = #{value}
  </select>
</mapper>
