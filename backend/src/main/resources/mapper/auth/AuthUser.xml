<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="authUser">
  <resultMap id="authUserResult" type="com.imageaiplatform.auth.domain.AuthUser">
    <constructor>
      <idArg column="username" javaType="string"/>
      <arg column="password_hash" javaType="string"/>
      <arg column="enabled" javaType="boolean"/>
    </constructor>
  </resultMap>
  <select id="findByUsername" parameterType="string" resultMap="authUserResult">
    SELECT username, password_hash, enabled
    FROM auth_user
    WHERE username = #{username}
  </select>
</mapper>
